def read_text(path):
    try:
        return Path(path).read_text().strip()
    except (OSError, ValueError):
        return None


def battery_directory():
    root = Path("/sys/class/power_supply")
    try:
        batteries = sorted(root.glob("BAT*"))
        for battery in batteries:
            if (battery / "type").exists():
                if read_text(battery / "type") == "Battery":
                    return battery
    except OSError:
        pass
    return None


def battery_information():
    battery = battery_directory()

    if not battery:
        return "Not available", None, "No battery detected"

    capacity = read_text(battery / "capacity")
    status = read_text(battery / "status") or "Unknown"

    percentage = None

    try:
        if capacity is not None:
            percentage = max(0, min(100, int(capacity)))
    except ValueError:
        pass

    health = None

    for prefix in ("energy", "charge"):
        full = read_text(battery / f"{prefix}_full")
        design = read_text(battery / f"{prefix}_full_design")

        try:
            if full and design and float(design) > 0:
                health = 100 * float(full) / float(design)
                break
        except ValueError:
            continue

    details = status

    if health is not None:
        details += f" · Health {health:.1f}%"

    return (
        f"{percentage}%" if percentage is not None else "Not available",
        percentage,
        details
    )


def cpu_temperature():
    root = Path("/sys/class/thermal")

    try:
        zones = sorted(root.glob("thermal_zone*"))
    except OSError:
        return "Not available"

    preferred = []
    fallback = []

    for zone in zones:
        kind = (read_text(zone / "type") or "").lower()
        raw = read_text(zone / "temp")

        try:
            value = float(raw) / 1000
        except (ValueError, TypeError):
            continue

        if not 0 <= value <= 120:
            continue

        if any(x in kind for x in ("x86_pkg_temp", "cpu", "pkg")):
            preferred.append(value)
        elif any(x in kind for x in ("acpitz", "soc")):
            fallback.append(value)

    values = preferred or fallback

    return f"{max(values):.1f}°C" if values else "Not available"


def memory_information():
    raw = read_text("/proc/meminfo")

    if not raw:
        return "Not available", None, ""

    values = {}

    for line in raw.splitlines():
        parts = line.split()

        if len(parts) >= 2:
            try:
                values[parts[0].rstrip(":")] = int(parts[1])
            except ValueError:
                pass

    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable")

    if not total or available is None:
        return "Not available", None, ""

    used = max(0, total - available)
    percent = max(0, min(100, round(100 * used / total)))

    return (
        f"{used / 1048576:.1f} / {total / 1048576:.1f} GiB",
        percent,
        f"{percent}% used"
    )


def controller_status():
    try:
        result = subprocess.run(
            ["lenovo-control", "status"],
            capture_output=True,
            text=True,
            timeout=3
        )
    except (OSError, subprocess.TimeoutExpired):
        return {}, "Controller unavailable"

    if result.returncode:
        return {}, result.stderr.strip() or "Controller unavailable"

    values = {}

    for line in result.stdout.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip()

    return values, None


class Card(QFrame):
    def __init__(self, title):
        super().__init__()
        self.setObjectName("card")

        layout = QVBoxLayout(self)
        layout.setContentsMargins(18, 16, 18, 16)
        layout.setSpacing(8)

        heading = QLabel(title)
        heading.setObjectName("cardTitle")

        self.value = QLabel("Loading...")
        self.value.setObjectName("value")

        self.detail = QLabel("")
        self.detail.setWordWrap(True)
        self.detail.setStyleSheet("color: #99a8bc;")

        self.progress = QProgressBar()
        self.progress.setTextVisible(False)
        self.progress.hide()

        layout.addWidget(heading)
        layout.addWidget(self.value)
        layout.addWidget(self.detail)
        layout.addWidget(self.progress)
        layout.addStretch()

    def update_value(self, value, detail="", percentage=None):
        self.value.setText(str(value))
        self.detail.setText(detail)

        if percentage is None:
            self.progress.hide()
        else:
            self.progress.show()
            self.progress.setValue(percentage)


class Dashboard(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle(f"Lenovo Control {APP_VERSION}")
        self.resize(980, 650)
        self.setMinimumSize(760, 540)

        self.process = None

        root = QWidget()
        self.setCentralWidget(root)

        main = QHBoxLayout(root)
        main.setContentsMargins(0, 0, 0, 0)
        main.setSpacing(0)

        sidebar = QFrame()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(210)

        side = QVBoxLayout(sidebar)
        side.setContentsMargins(18, 28, 18, 20)
        side.setSpacing(12)

        brand = QLabel("LENOVO\nCONTROL")
        brand.setStyleSheet(
            "font-size: 19px; font-weight: bold; color: #f0f4fa;"
        )

        side.addWidget(brand)
        side.addSpacing(25)

        self.dashboard_button = QPushButton("Dashboard")
        self.dashboard_button.setObjectName("primary")

        self.about_button = QPushButton("About")

        side.addWidget(self.dashboard_button)
        side.addWidget(self.about_button)
        side.addStretch()

        version = QLabel(f"Version {APP_VERSION}")
        version.setStyleSheet("color: #8997aa;")
        side.addWidget(version)

        main.addWidget(sidebar)

        self.pages = QStackedWidget()
        main.addWidget(self.pages, 1)

        self.build_dashboard()
        self.build_about()

        self.dashboard_button.clicked.connect(
            lambda: self.pages.setCurrentIndex(0)
        )
        self.about_button.clicked.connect(
            lambda: self.pages.setCurrentIndex(1)
        )

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)

        self.refresh()

    def build_dashboard(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(28, 25, 28, 25)
        layout.setSpacing(20)

        title = QLabel("System Dashboard")
        title.setObjectName("heading")
        layout.addWidget(title)

        subtitle = QLabel(
            "Performance, battery management and hardware monitoring"
        )
        subtitle.setStyleSheet("color: #9aa8ba;")
        layout.addWidget(subtitle)

        cards = QGridLayout()
        cards.setSpacing(14)

        self.cpu = Card("CPU Temperature")
        self.memory = Card("Memory Usage")
        self.battery = Card("Battery")

        cards.addWidget(self.cpu, 0, 0)
        cards.addWidget(self.memory, 0, 1)
        cards.addWidget(self.battery, 0, 2)

        layout.addLayout(cards)

        performance = QFrame()
        performance.setObjectName("card")

        p_layout = QVBoxLayout(performance)
        p_layout.setContentsMargins(18, 16, 18, 16)

        p_title = QLabel("Performance Profile")
        p_title.setStyleSheet("font-size: 17px; font-weight: bold;")

        self.profile_status = QLabel("Loading...")

        p_layout.addWidget(p_title)
        p_layout.addWidget(self.profile_status)

        p_buttons = QHBoxLayout()

        self.profile_buttons = []

        for label, mode in (
            ("Quiet", "low-power"),
            ("Balanced", "balanced"),
            ("Performance", "performance")
        ):
            button = QPushButton(label)
            button.clicked.connect(
                lambda checked=False, m=mode:
                self.change_setting("profile", m)
            )
            self.profile_buttons.append(button)
            p_buttons.addWidget(button)

        p_layout.addLayout(p_buttons)
        layout.addWidget(performance)

        conservation = QFrame()
        conservation.setObjectName("card")

        c_layout = QVBoxLayout(conservation)
        c_layout.setContentsMargins(18, 16, 18, 16)

        c_title = QLabel("Battery Conservation")
        c_title.setStyleSheet("font-size: 17px; font-weight: bold;")

        self.conservation_status = QLabel("Loading...")

        c_layout.addWidget(c_title)
        c_layout.addWidget(self.conservation_status)

        c_buttons = QHBoxLayout()

        self.conservation_buttons = []

        for label, mode in (
            ("Enable", "on"),
            ("Disable", "off")
        ):
            button = QPushButton(label)
            button.clicked.connect(
                lambda checked=False, m=mode:
                self.change_setting("conservation", m)
            )
            self.conservation_buttons.append(button)
            c_buttons.addWidget(button)

        c_layout.addLayout(c_buttons)
        layout.addWidget(conservation)

        self.message = QLabel("Ready")
        self.message.setWordWrap(True)
        self.message.setStyleSheet("color: #9aabc1;")

        layout.addWidget(self.message)
        layout.addStretch()

        self.pages.addWidget(page)

    def build_about(self):
        page = QWidget()
        layout = QVBoxLayout(page)
        layout.setContentsMargins(35, 35, 35, 35)

        title = QLabel("About Lenovo Control")
        title.setObjectName("heading")

        info = QLabel(
            "Unofficial Lenovo IdeaPad power and battery controller.\n\n"
            "Built with Python and Qt 6.\n\n"
            "Performance profiles and battery conservation depend on "
            "hardware and Linux kernel support.\n\n"
            "This project is not affiliated with Lenovo."
        )

        info.setWordWrap(True)

        layout.addWidget(title)
        layout.addSpacing(20)
        layout.addWidget(info)
        layout.addStretch()

        self.pages.addWidget(page)

    def set_busy(self, busy):
        for button in self.profile_buttons + self.conservation_buttons:
            button.setEnabled(not busy)

    def change_setting(self, operation, mode):
        if self.process is not None:
            return

        self.set_busy(True)
        self.message.setText(f"Applying {operation}: {mode}...")

        process = QProcess(self)
        self.process = process

        process.setProgram("lenovo-control")
        process.setArguments([operation, mode])

        process.finished.connect(self.setting_finished)
        process.errorOccurred.connect(self.setting_error)

        process.start()

    def setting_error(self, error):
        if self.process is None:
            return

        if error == QProcess.ProcessError.FailedToStart:
            self.message.setText("Unable to start Lenovo Control.")
            self.process.deleteLater()
            self.process = None
            self.set_busy(False)

    def setting_finished(self, exit_code, exit_status):
        process = self.process

        if process is None:
            return

        stderr = bytes(process.readAllStandardError()).decode(
            errors="replace"
        ).strip()

        stdout = bytes(process.readAllStandardOutput()).decode(
            errors="replace"
        ).strip()

        if exit_code != 0 or exit_status != QProcess.ExitStatus.NormalExit:
            self.message.setText(
                stderr or stdout or f"Operation failed ({exit_code})"
            )
        else:
            self.message.setText("Setting updated successfully.")

        process.deleteLater()
        self.process = None
        self.set_busy(False)
        self.refresh()

    def refresh(self):
        self.cpu.update_value(cpu_temperature())

        memory, percent, detail = memory_information()
        self.memory.update_value(memory, detail, percent)

        battery, percentage, detail = battery_information()
        self.battery.update_value(battery, detail, percentage)

        values, error = controller_status()

        if error:
            self.profile_status.setText(error)
            self.conservation_status.setText("Unavailable")
            return

        profile = values.get("Performance", "Unknown")
        conservation = values.get("Conservation", "unsupported")

        self.profile_status.setText(f"Current mode: {profile}")

        if conservation == "1":
            text = "Enabled"
        elif conservation == "0":
            text = "Disabled"
        else:
            text = conservation

        self.conservation_status.setText(f"Current state: {text}")


